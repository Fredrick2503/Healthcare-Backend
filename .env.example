# Django Core Settings
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-key-example-xyz123
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# PostgreSQL Configuration
POSTGRES_DB=whatbytes_db
POSTGRES_USER=whatbytes_user
POSTGRES_PASSWORD=whatbytes_password
DB_HOST=db
DB_PORT=5432

# Redis Configuration (Optional for JWT Revocation & High-Speed Cache)
REDIS_URL=redis://redis:6379/1
USE_REDIS_FOR_JWT=True

# JWT Token Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
