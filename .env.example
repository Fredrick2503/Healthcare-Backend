# ==============================================================================
# WhatBytes Healthcare Management API - Environment Configuration Template
# Copy this file to '.env' and update the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
# Set DEBUG to False in production!
DEBUG=True

# Django secret key (generate a unique, random string in production)
SECRET_KEY=django-insecure-change-this-in-production-key-example-xyz123

# Comma-separated list of host/domain names that this Django site can serve
ALLOWED_HOSTS=localhost,127.0.0.1,web,0.0.0.0

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Set USE_SQLITE=True if developing locally without Docker/PostgreSQL.
# Defaults to False (uses PostgreSQL in Docker and production).
USE_SQLITE=False

# PostgreSQL Settings (Used by Docker service 'db' and Django)
POSTGRES_DB=whatbytes_db
POSTGRES_USER=whatbytes_user
POSTGRES_PASSWORD=whatbytes_password
DB_HOST=db
DB_PORT=5432

# ------------------------------------------------------------------------------
# Redis & Caching Configuration
# ------------------------------------------------------------------------------
# Redis connection URL (used for cache and instantaneous JWT token revocation)
REDIS_URL=redis://redis:6379/1

# Enable Redis blacklist checks on each JWT-authenticated request
USE_REDIS_FOR_JWT=True

# ------------------------------------------------------------------------------
# SimpleJWT Token Expiration Settings
# ------------------------------------------------------------------------------
# Access token validity in minutes (default: 60)
ACCESS_TOKEN_LIFETIME_MINUTES=60

# Refresh token validity in days (default: 7)
REFRESH_TOKEN_LIFETIME_DAYS=7

# ------------------------------------------------------------------------------
# Docker Container Ports (Optional Compose overrides)
# ------------------------------------------------------------------------------
WEB_PORT=8000
DB_PORT_HOST=5432
REDIS_PORT_HOST=6379
